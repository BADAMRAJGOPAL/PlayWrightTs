{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",

    "baseUrl": ".",

    "types": ["node", "@playwright/test"],

    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,

    "resolveJsonModule": true
  },
  "include": ["src", "src/tests", "**/*.ts", "src/tests"]
}